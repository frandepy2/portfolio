---
const certs = [
  {
    title: "Flutter — Your Complete Guide for iOS and Android",
    issuer: "Udemy",
    date: "May 2023",
    url: "https://www.udemy.com/certificate/UC-c5ecc0fc-ee2e-4922-b506-4d0e88ede3d0/",
  },
  {
    title: "Riverpod Providers with Annotations",
    issuer: "DevTalles",
    date: "November 2023",
    url: "https://cursos.devtalles.com/certificates/cprbjri46v",
  },
  {
    title: "B2 Upper Intermediate English",
    issuer: "EF SET",
    date: "September 2023",
    url: "https://cert.efset.org/3Mgqmi",
  },
  {
    title: "Spring Boot Course",
    issuer: "Platzi",
    date: "December 2023",
    url: "https://platzi.com/p/frandepy57/curso/1996-java-spring/diploma/detalle/",
  },
  {
    title: "Swift Introduction",
    issuer: "Platzi",
    date: "April 2024",
    url: "https://platzi.com/p/frandepy57/curso/1772-swift-5/diploma/detalle/",
  },
];
---

<section id="certifications" class="bg-slate-900 py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 fade-up">
      <p class="text-indigo-400 text-sm font-semibold uppercase tracking-widest mb-3">Learning</p>
      <h2 class="text-4xl font-bold text-white">Certifications & Courses</h2>
      <p class="text-slate-400 mt-4">Continuous learning to stay at the cutting edge.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 fade-up">
      {certs.map(cert => (
        <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl p-6 flex flex-col justify-between hover:border-indigo-500/40 hover:bg-slate-800 transition-all duration-200 group">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-semibold text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-2.5 py-1 rounded-full">{cert.issuer}</span>
              <span class="text-xs text-slate-500">{cert.date}</span>
            </div>
            <h3 class="text-white font-semibold leading-snug">{cert.title}</h3>
          </div>
          <a
            href={cert.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1.5 text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors group-hover:gap-2.5"
          >
            View credential
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
