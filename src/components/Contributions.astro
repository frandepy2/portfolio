---
import contribution1 from "../assets/contribution_1.png";
---

<section id="contributions" class="bg-slate-900 py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 fade-up">
      <p class="text-indigo-400 text-sm font-semibold uppercase tracking-widest mb-3">Open Source</p>
      <h2 class="text-4xl font-bold text-white">Contributions</h2>
      <p class="text-slate-400 mt-4">Giving back to the community that has given so much to me.</p>
    </div>

    <div class="max-w-xl mx-auto fade-up">
      <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl overflow-hidden hover:border-indigo-500/40 hover:-translate-y-1 transition-all duration-200 group">
        <div class="overflow-hidden h-48">
          <img src={contribution1.src} alt="Open Source Contribution — app_settings Flutter plugin" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-semibold text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-2.5 py-1 rounded-full">Flutter Plugin</span>
            <span class="text-xs font-semibold text-violet-400 bg-violet-500/10 border border-violet-500/20 px-2.5 py-1 rounded-full">Published on pub.dev</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">app_settings — Swift Package Manager Support</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Contributed SPM (Swift Package Manager) support to the open-source Flutter plugin <strong class="text-slate-300">app_settings</strong>, improving iOS dependency management for developers everywhere. Involved analyzing the plugin's architecture, integrating SPM, and ensuring compatibility across environments.
          </p>
          <div class="flex flex-wrap gap-1.5 mt-4">
            {["Flutter", "Swift Package Manager", "iOS", "Open Source"].map(tag => (
              <span class="text-xs bg-slate-700/60 text-slate-400 px-2 py-0.5 rounded">{tag}</span>
            ))}
          </div>
          <div class="mt-5 flex flex-wrap gap-4">
            <a href="https://github.com/spencerccf/app_settings/pull/230" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors">
              See Pull Request
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a href="https://pub.dev/packages/app_settings" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-violet-400 hover:text-violet-300 font-medium transition-colors">
              View on pub.dev v5.2.0
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
