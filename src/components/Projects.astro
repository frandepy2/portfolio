---
import chatapp from "../assets/chatapp.png";
import grpcfeature from "../assets/feature-flags.png";

type Project = {
  title: string;
  description: string;
  tags: string[];
  url: string;
  label: string;
  image?: string;
  icon?: string;
};

const projects: Project[] = [
  {
    image: chatapp.src,
    title: "Firebase ChatApp",
    description: "Real-time chat application built with Flutter and Firebase, developed as part of MoureDev's programming challenges. Features Google Sign-In authentication, real-time message syncing, and a responsive UI for a seamless chatting experience.",
    tags: ["Flutter", "Firebase", "Google Auth", "Real-time"],
    url: "https://github.com/frandepy2/firebase-chat",
    label: "View on GitHub",
  },
  {
    image: grpcfeature.src,
    title: "Feature Flags with gRPC",
    description: "A feature flag system built with gRPC, enabling real-time feature toggling across services. Designed to demonstrate how gRPC can power dynamic configuration and controlled rollouts in a distributed architecture.",
    tags: ["gRPC", "Feature Flags", "Distributed Systems"],
    url: "https://github.com/frandepy2/features-flags-grpc",
    label: "View on GitHub",
  },
];
---

<section id="projects" class="bg-slate-950 py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 fade-up">
      <p class="text-indigo-400 text-sm font-semibold uppercase tracking-widest mb-3">Portfolio</p>
      <h2 class="text-4xl font-bold text-white">Featured Projects</h2>
      <p class="text-slate-400 mt-4 max-w-xl mx-auto">
        A selection of projects that showcase my skills and problem-solving approach.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto fade-up">
      {projects.map(project => (
        <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl overflow-hidden flex flex-col hover:border-indigo-500/40 hover:-translate-y-1 transition-all duration-200 group">
          <div class="overflow-hidden h-48">
            {project.image
              ? <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              : <div class="w-full h-full bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center">
                  <img src={project.icon} alt={project.title} class="w-20 h-20 object-contain opacity-60 group-hover:opacity-80 transition-opacity duration-300" />
                </div>
            }
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="text-lg font-semibold text-white mb-2">{project.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed flex-1 text-justify">{project.description}</p>
            <div class="flex flex-wrap gap-1.5 mt-4">
              {project.tags.map(tag => (
                <span class="text-xs bg-slate-700/60 text-slate-400 px-2 py-0.5 rounded">{tag}</span>
              ))}
            </div>
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1.5 text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors"
            >
              {project.label}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
