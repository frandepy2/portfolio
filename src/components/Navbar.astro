<header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/60">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href="#home" class="text-lg font-bold gradient-text tracking-tight">Francisco Sanabria</a>

    <ul class="hidden md:flex items-center space-x-8">
      <li><a href="#about" class="text-slate-400 hover:text-indigo-400 transition-colors duration-200 text-sm font-medium">About</a></li>
      <li><a href="#skills" class="text-slate-400 hover:text-indigo-400 transition-colors duration-200 text-sm font-medium">Skills</a></li>
      <li><a href="#work" class="text-slate-400 hover:text-indigo-400 transition-colors duration-200 text-sm font-medium">Experience</a></li>
      <li><a href="#education" class="text-slate-400 hover:text-indigo-400 transition-colors duration-200 text-sm font-medium">Education</a></li>
      <li><a href="#projects" class="text-slate-400 hover:text-indigo-400 transition-colors duration-200 text-sm font-medium">Projects</a></li>
      <li>
        <a href="#contact" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-full text-sm font-medium transition-colors duration-200">
          Contact
        </a>
      </li>
    </ul>

    <button id="menu-button" class="md:hidden text-slate-400 hover:text-white transition-colors" aria-label="Toggle menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden bg-slate-900 border-t border-slate-800">
    <ul class="space-y-1 px-6 py-4">
      <li><a href="#about" class="block py-2 text-slate-300 hover:text-indigo-400 transition-colors text-sm font-medium">About</a></li>
      <li><a href="#skills" class="block py-2 text-slate-300 hover:text-indigo-400 transition-colors text-sm font-medium">Skills</a></li>
      <li><a href="#work" class="block py-2 text-slate-300 hover:text-indigo-400 transition-colors text-sm font-medium">Experience</a></li>
      <li><a href="#education" class="block py-2 text-slate-300 hover:text-indigo-400 transition-colors text-sm font-medium">Education</a></li>
      <li><a href="#projects" class="block py-2 text-slate-300 hover:text-indigo-400 transition-colors text-sm font-medium">Projects</a></li>
      <li><a href="#contact" class="block py-2 text-indigo-400 font-medium text-sm">Contact</a></li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  menu?.querySelectorAll('a').forEach(link =>
    link.addEventListener('click', () => menu.classList.add('hidden'))
  );
</script>
